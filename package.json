{
  "name": "seedplanet",
  "description": "SeedPlanet 3D Game",
  "author": "NSK-Natsuki",
  "private": true,
  "version": "2.0.14",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist-electron",
    "lint": "tsc --noEmit",
    "generate-icons": "node scripts/generate-icons.js",
    "dev:electron": "electron .",
    "build:electron": "vite build && electron-builder --linux AppImage",
    "build:win-x64": "vite build && electron-builder --win nsis appx --x64",
    "build:win-arm64": "vite build && electron-builder --win appx --arm64",
    "build:win-all": "vite build && electron-builder --win nsis appx --x64 && electron-builder --win appx --arm64"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^13.1.1",
    "javascript-obfuscator": "^5.5.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "postcss": "^8.4.38",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^3.4.17",
    "three": "^0.185.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "html-minifier-terser": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.30.0",
    "@rollup/rollup-win32-x64-msvc": "^4.30.0"
  },
  "build": {
    "appId": "NSK-Natsuki.SeedPlanet",
    "productName": "SeedPlanet",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icons"
    },
    "win": {
      "target": [
        "nsis",
        "appx"
      ],
      "icon": "electron/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SeedPlanet",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "appx": {
      "identityName": "NSK-Natsuki.SeedPlanet",
      "applicationId": "SeedPlanet",
      "publisher": "CN=F2BD52C0-1826-4F4C-953A-B27311D542C3",
      "publisherDisplayName": "NSK-Natsuki",
      "displayName": "SeedPlanet",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "NSK912",
      "repo": "seedplanet-Build"
    }
  }
}
